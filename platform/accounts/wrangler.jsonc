{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "canopy-accounts-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "LOCAL_DEVELOPMENT": "true",
    "AUTH_ORIGINS": "http://localhost:5175,http://127.0.0.1:5175"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "canopy-accounts-local",
    "database_id": "local-only-canopy-accounts",
    "migrations_dir": "migrations",
    "migrations_table": "schema_migrations"
  }],
  "ratelimits": [{
    "name": "EMAIL_AUTH_LIMIT",
    "namespace_id": "1002",
    "simple": { "limit": 20, "period": 60 }
  }, {
    "name": "GOOGLE_AUTH_LIMIT",
    "namespace_id": "1003",
    "simple": { "limit": 20, "period": 60 }
  }]
}

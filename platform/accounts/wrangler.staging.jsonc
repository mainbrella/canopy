{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "canopy-accounts-stg",
  "account_id": "2b7a9be82bb64187230703b024e25157",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "LOCAL_DEVELOPMENT": "false",
    "AUTH_ORIGINS": "https://stg.mainbrella.com",
    "OPERATOR_USER_ID": "0406e934-d13d-4d47-a826-62de3e02faa4",
    "VOICE_BILLING_MODE": "owner_funded",
    "VOICE_INSTALL_ENABLED": "true",
    "SESSION_COOKIE_NAME": "__Host-canopy_stg_session"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canopy-accounts-stg",
      "database_id": "824e7e4b-b015-416a-93ec-f09ad56ef4d9",
      "migrations_dir": "migrations",
      "migrations_table": "schema_migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "EMAIL_AUTH_LIMIT",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "GOOGLE_AUTH_LIMIT",
      "namespace_id": "2002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "api-stg.mainbrella.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "VOICE",
      "service": "canopy-voice-stg"
    }
  ]
}

{
  "name": "@canopy/voice",
  "private": true,
  "type": "module",
  "exports": {
    "./routes": "./worker/app/voice.ts",
    "./billing": "./worker/lib/voice-billing.ts",
    "./call": "./worker/durable-objects/receptionist-call.ts",
    "./openapi": "./worker/openapi.ts",
    "./web": "./web/voice.ts",
    "./landing": "./web/voice-landing.ts"
  },
  "scripts": {
    "test": "npm run test:worker && npm run test:web",
    "test:worker": "tsx --test worker/app/*.test.ts worker/durable-objects/*.test.ts",
    "test:web": "tsx --test web/*.test.ts",
    "type-check": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@cloudflare/voice": "^0.5.0",
    "agents": "^0.28.1",
    "twilio": "^5.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

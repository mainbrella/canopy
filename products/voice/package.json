{
  "name": "@canopy/voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run build:client && node scripts/wrangler.mjs dev --local --ip 127.0.0.1 --port 8791",
    "build:client": "vite build",
    "build": "npm run build:client && node scripts/wrangler.mjs deploy --dry-run --outdir dist/worker",
    "type-check": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
    "test": "tsx --test test/*.test.ts src/*.test.ts",
    "db:migrate:local": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "catalog:manifest": "node scripts/catalog-manifest.mjs"
  },
  "dependencies": {
    "@cloudflare/voice": "0.5.0",
    "agents": "0.28.1",
    "twilio": "5.13.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.1",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.149.0"
  }
}
